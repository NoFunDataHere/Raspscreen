[Unit]
Description=antigravity remote-control daemon
After=network.target network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do getent hosts oauth2.googleapis.com >/dev/null 2>&1 && exit 0; sleep 2; done; exit 1'
ExecStart=/home/raspscreen/.local/bin/agy remote-control serve
Restart=on-failure
RestartSec=10s
RestartPreventExitStatus=3
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
