[Unit]
Description=RaspEcran Serveur Web & API Kiosque
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/RaspEcran
ExecStart=/usr/bin/python3 /home/pi/RaspEcran/server.py
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
